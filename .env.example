# ==============================================================================
# Auto-Researcher Production & Development Environment Configuration
# Copy this file to .env and replace placeholders with your real secrets.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development, staging, production
AUTO_RESEARCHER_ENV=development

# Cryptographically strong secret key used for signing JWT authentication tokens.
# REQUIRED for production: Generate using: python -c "import secrets; print(secrets.token_hex(32))"
AUTO_RESEARCHER_SECRET=replace-with-a-cryptographically-strong-64-char-secret-key

# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. CORS & SECURITY
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web frontend origins (no trailing slashes)
# In production, specify your exact Vercel or custom domain.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL & SQLITE)
# ------------------------------------------------------------------------------
# Production connection string (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://auto_researcher:your_secure_db_password@localhost:5432/auto_researcher

# Local development fallback (SQLite file):
# DATABASE_URL=sqlite+aiosqlite:///./auto_researcher.db

# Docker Compose PostgreSQL service defaults
POSTGRES_DB=auto_researcher
POSTGRES_USER=auto_researcher
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 4. REDIS / REALTIME EVENT BUS
# ------------------------------------------------------------------------------
# Redis connection URL for real-time WebSocket pub/sub streaming
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. ARTIFACT & EXPERIMENT STORAGE
# ------------------------------------------------------------------------------
# Directory where generated research artifacts, papers, and logs are saved.
ARTIFACTS_ROOT=../artifacts

# ------------------------------------------------------------------------------
# 6. RESEARCH WORKER ENGINE
# ------------------------------------------------------------------------------
# Maximum duration (seconds) a worker holds a run lease before re-election
LEASE_SECONDS=90

# Polling interval (seconds) for queued research runs
WORKER_POLL_SECONDS=3

# Maximum automatic retries for a failed pipeline stage
MAX_STAGE_RETRIES=3

# ------------------------------------------------------------------------------
# 7. AI MODEL PROVIDERS (API KEYS)
# ------------------------------------------------------------------------------
# OpenAI (GPT-4o, o1, o3-mini)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (Claude 3.5 Sonnet, Claude 3.7)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# DeepSeek (DeepSeek-V3, DeepSeek-R1)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Qwen / DashScope
QWEN_API_KEY=your-qwen-api-key-here

# Semantic Scholar Academic Search API (optional, provides higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key-here

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT CONFIGURATION (NEXT.JS)
# ------------------------------------------------------------------------------
# Public API base URL used by browser client to communicate with FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public WebSocket URL used for live stage execution streaming
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
